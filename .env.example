ANTHROPIC_BASE_URL=https://your-proxy.example
ANTHROPIC_API_KEY=
CG_MODEL=gpt-5.4-mini
CG_FALLBACK_MODEL=claude-sonnet-5
CG_DATA_DIR=.runtime
CG_ANALYSIS_CONCURRENCY=3
CG_EXPLORE_TIMEOUT_SECONDS=90
# Optional single-owner API credential (32+ ASCII characters).
# If omitted, generated once in CG_DATA_DIR/server-token.txt. Never use the Proxy key.
# CG_SERVER_TOKEN=
